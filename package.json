{
  "name": "@nckrtl/launch-ui",
  "version": "0.0.1",
  "description": "A React component library and Vite toolchain for building Laravel + React + Inertia apps. Built on Base UI and shadcn.",
  "author": "nckrtl <nick.retel@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/nckrtl/launch-ui#readme",
  "bugs": {
    "url": "https://github.com/nckrtl/launch-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nckrtl/launch-ui.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./vite": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.ts && vp test src/vite/config.test.ts",
    "dev": "storybook dev -p 6006",
    "build": "shadcn build",
    "build:lib": "vp pack src/vite/index.ts --dts --format esm --out-dir dist --deps.neverBundle vite",
    "build:storybook": "storybook build && rsync -a storybook-static/ public/",
    "serve": "npx http-server public -p 4100 -c-1 --cors"
  },
  "devDependencies": {
    "@base-ui/react": "^1.3.0",
    "@chromatic-com/storybook": "^5.3.0",
    "@inertiajs/react": "^3.0.0",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-mcp": "10.6.1",
    "@storybook/addon-themes": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.13.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "react-is": "^19.2.4",
    "react-resizable-panels": "^4.7.5",
    "recharts": "^3.8.0",
    "reselect": "^5.2.0",
    "shadcn": "^4.1.0",
    "sonner": "^2.0.7",
    "storybook": "10.6.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vaul": "^1.1.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "^0.3.3"
  },
  "peerDependencies": {
    "@inertiajs/vite": "^3.0.0",
    "@laravel/vite-plugin-wayfinder": "^0.1.0",
    "@tailwindcss/vite": "^4.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "laravel-vite-plugin": "^3.0.0",
    "vite-plus": "^0.2.1 || ^0.3.0"
  },
  "peerDependenciesMeta": {
    "vite-plugin-run": {
      "optional": true
    }
  },
  "packageManager": "npm@11.12.1",
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "storybook": {
      "vite-plus": "$vite-plus"
    }
  }
}
